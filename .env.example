# Server
PORT=3000

# Data locations (absolute paths or paths relative to the project root).
# Defaults: <project>/data/app.db and <project>/data/uploads
# DATA_DIR=/home/you/35l-data
# DATABASE_PATH=/home/you/35l-data/app.db
# UPLOADS_DIR=/home/you/35l-data/uploads

# Change this in any real deployment (used to sign session cookies).
SESSION_SECRET=change-me-to-a-long-random-string

# OCR engine (tesseract CLI). Override only if tesseract is not on PATH.
# TESSERACT_BIN=/usr/bin/tesseract
